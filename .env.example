# Credenciales de tu app en https://developers.mercadolibre.com.ar/
ML_CLIENT_ID=tu_client_id
ML_CLIENT_SECRET=tu_client_secret

# Debe ser EXACTAMENTE la misma URL que pusiste como "redirect_uri" al crear la app.
# En local: http://localhost:3000/api/auth/callback
# En producción (Vercel): https://tu-app.vercel.app/api/auth/callback
ML_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Site id de Mercado Libre Argentina (no cambiar salvo que quieras otro país)
ML_SITE_ID=MLA

# Credenciales de Upstash Redis (plan gratuito) -> https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
